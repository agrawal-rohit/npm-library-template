{
	"name": "{{packageName}}",
	"version": "0.0.1",
	"type": "module",
	{{#packageDescription}}
	"description": "{{packageDescription}}",
	{{/packageDescription}}
	{{#publishToNpm}}
	"license": "{{licenseId}}",
	"homepage": "https://github.com/{{githubUsername}}/{{packageName}}#readme",
	"bugs": "https://github.com/{{githubUsername}}/{{packageName}}/issues",
	"repository": "https://github.com/{{githubUsername}}/{{packageName}}",
	"author": "{{authorName}}",
	{{/publishToNpm}}
	{{^publishToNpm}}
	"private": true,
	{{/publishToNpm}}
	"engines": {
		"node": ">=20"
	},
	"files": ["dist"],
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	}{{#hasPlayground}},
	"peerDependencies": {
		"react": "^19",
		"react-dom": "^19"
	}
	{{/hasPlayground}}
}
